rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The one Google account allowed to manage all content.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'navjitdebnath5@gmail.com';
    }

    // Blog posts (recipes included). The site's deploy builds a static page for
    // each, reading them with a read-only Google Cloud account (IAM, which
    // these rules don't govern). Visitors get one post at a time: the page for
    // a post published since the last deploy reads it by its id. Only the
    // admin can list them all, or create, edit and delete.
    match /posts/{postId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Analytics — site visitors can log an event (no auth); only the admin can
    // read the dashboard or backfill geo onto existing events (e.g. resolving
    // country from a stored IP). Visitors can never edit, and nothing is deletable.
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Anything not listed above is denied to everyone.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
